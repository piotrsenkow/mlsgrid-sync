# Copy to .env (gitignored). All are read as plain environment variables.
MLSGRID_DATABASE_URL=postgres://user:pass@localhost:5432/mls?sslmode=disable
MLSGRID_TOKEN_MRED=your-mls-grid-bearer-token

# Only for media.sink.type: s3 — standard AWS credential chain (works with
# MinIO, Cloudflare R2, and other S3-compatible endpoints).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
